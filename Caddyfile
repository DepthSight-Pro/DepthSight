{
    # Global options
    email {$EMAIL}
    admin off
}

# The {$DOMAIN} can be an IP or a real domain
{$DOMAIN} {
    # API (Using handle to preserve /api path)
    handle /api/* {
        reverse_proxy api:8000
    }

    # WebSockets
    handle /ws* {
        reverse_proxy websocket:8765
    }

    # PWA
    handle /pwa/* {
        reverse_proxy pwa:80
    }

    # OG Images
    handle /og-image/* {
        reverse_proxy api:8000
    }

    # Render shared page with OG metadata
    handle /render-shared/* {
        reverse_proxy api:8000
    }

    # Affiliate redirector
    handle /r/* {
        reverse_proxy api:8000
    }

    # Social bots and link crawlers fetching shared backtests -> route to api
    @shared_bot {
        path /s/*
        header_regexp User-Agent "(?i)(bot|crawler|spider|scraper|preview|opengraph|metatags|facebookexternalhit|whatsapp|skypeuripreview|vkshare)"
    }
    handle @shared_bot {
        reverse_proxy api:8000
    }

    # Frontend (Everything else)
    handle {
        reverse_proxy frontend:80
    }

    log {
        output file /var/log/caddy/access.log
    }
}
