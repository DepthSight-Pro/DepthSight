# Auth and encryption
# Use real secrets here. API_ENCRYPTION_KEY must be a valid Fernet key.
JWT_SECRET_KEY=replace_with_a_long_random_secret
CONFIRMATION_SECRET_KEY=replace_with_a_separate_long_random_secret
API_KEY_SECRET=replace_with_the_backend_api_key_secret
API_ENCRYPTION_KEY=replace_with_a_valid_fernet_key
GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
# Login brute-force protection (applies to POST /token). Default 5/hour is
# strict on purpose - shared NAT/corporate egress users share one bucket.
# Raise consciously, e.g. 20/minute for a promo.
RATE_LIMIT_LOGIN=20/minute

