# Core infrastructure
POSTGRES_USER=depthsight_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=depthsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy connection pool, per process.
# A trading controller holds its own session (bot_runner.py), so a bot shard needs
# roughly one connection per controller while a candle boundary is being processed.
# SQLAlchemy defaults are pool_size=5 / max_overflow=10 => only 15 connections, which
# makes larger shards fail with "QueuePool limit of size 5/overflow 10 reached".
# Keep DB_POOL_SIZE + DB_MAX_OVERFLOW >= controllers per shard, and stay under the
# server's max_connections (default 100) summed over all processes. For larger
# deployments put PgBouncer in front and point POSTGRES_HOST at it.
# pool_pre_ping and pool_recycle are required because controller sessions live for
# the whole process lifetime and would otherwise use long-stale TCP connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# asyncpg prepared-statement cache. Leave unset for direct Postgres. Set to 0
# when POSTGRES_HOST points at PgBouncer in transaction mode (see
# docker-compose.pgbouncer.yml) - prepared statements do not survive pooling.
# DB_STATEMENT_CACHE_SIZE=0
# Direct DSN bypassing PgBouncer, for session-level guarantees pooling cannot
# provide (mining-epoch advisory lock). Unset = same as the main DSN. Set to
# the REAL Postgres URL when using the pooler, e.g.:
# DB_DIRECT_DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/dbname

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MARKET_REDIS_HOST=localhost
MARKET_REDIS_PORT=6379
MARKET_REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=change_me_redis_shared_fallback
REDIS_API_PASSWORD=change_me_redis_api
REDIS_WEBSOCKET_PASSWORD=change_me_redis_websocket
REDIS_BOT_PASSWORD=change_me_redis_bot
REDIS_CELERY_PASSWORD=change_me_redis_celery
REDIS_MARKET_DATA_PASSWORD=change_me_redis_market_data

# Cap on connections per Redis client (default 5). Every trading controller
# builds its own clients, and redis-py defaults to 50 per pool - past ~100
# controllers that means thousands of fds and EMFILE under burst load.
REDIS_POOL_MAX_CONNECTIONS=5

# How long POST /api/v1/strategies waits for the bot to confirm it applied
# START_STRATEGY (command ack, A2 fix) before answering 202 unconfirmed.
BOT_COMMAND_ACK_TIMEOUT_SECONDS=30

# Live position-size cap as a fraction of balance (default 2.0 = 200% notional).
# Bounds live sizing independently of the backtester cap (A7 fix): without it a
# dust stop targets tens of times the balance and only the exchange margin
# check stops it, late and per-account.
MAX_REAL_POSITION_SIZE_PCT_BALANCE=10.0

# Random pre-entry delay cap, uniform(0, this), live orders only. Spreads a
# candle-close burst across seconds so hundreds of bots don't trip per-IP rate
# limits in the same second (Bitget 100/s, Bybit 600/5s + 10-min ban). 0 = off.
# Recommended 5 for mass-start ramps and the promo, 0 for deterministic tests.
ENTRY_JITTER_MAX_SECONDS=3

# Lazy private user-data streams (one shared loop per exchange key).
# Exchanges cap simultaneous private WS per IP (Bitget 100, WEEX spot 20) and
# single-session exchanges kick the previous login. Streams open on first live
# demand and close after the idle timeout below.
# PRIVATE_WS_MODE: auto (default) | always (legacy boot-open) | never (REST polling only).
PRIVATE_WS_MODE=auto
PRIVATE_WS_IDLE_TIMEOUT_SECONDS=300
# Comma list, never opened (REST polling instead). WEEX default: 20 WS/IP max
# makes streams unusable at scale, and a 2nd login kicks the 1st.
PRIVATE_WS_POLL_ONLY_EXCHANGES=weex
# Streamless REST poll cadence for live positions without a healthy loop.
PRIVATE_WS_POLL_INTERVAL_SECONDS=15
PRIVATE_WS_POLL_JITTER_SECONDS=5
# Process-global private-WS connection budget per exchange (simultaneous loops
# on this host/IP). When a manager raises an exchange cap, raise the matching
# budget here: one-line change, no release. Over-budget hot keys (closest to
# TP/SL) take over the coldest loop; the rest stay on REST poll.
PRIVATE_WS_CONN_BUDGET_BITGET=80
PRIVATE_WS_CONN_BUDGET_WEEX=0
PRIVATE_WS_CONN_BUDGET_BYBIT=400
PRIVATE_WS_CONN_BUDGET_OKX=200
# Max stream OPEN attempts per minute per exchange (sliding window). Per-key
# throttles cannot bound 1000 controllers retrying at once (would breach
# Bitget 300/IP/5min alone and earn an IP ban).
PRIVATE_WS_CONN_RATE_PER_MIN_BITGET=30
PRIVATE_WS_CONN_RATE_PER_MIN_BYBIT=60
PRIVATE_WS_CONN_RATE_PER_MIN_OKX=100
# Physical TCP connections per shared loop (Bitget opens a 2nd orders-algo
# channel for plan SL/TP; lower to 1 if multiplexing is confirmed).
PRIVATE_WS_CONNS_PER_KEY_BITGET=2
# Promotion hysteresis + hot-poll cadence (hot = position <0.5% from TP/SL).
PRIVATE_WS_PROMOTE_MARGIN=1.5
PRIVATE_WS_MIN_HOLD_SECONDS=60
PRIVATE_WS_HOT_POLL_INTERVAL_SECONDS=8
PRIVATE_WS_HOT_POLL_DISTANCE=0.005
# Hot-path kline backfill: min seconds between REST backfills per key (a
# silently dead channel once froze a strategy for 3 days with zero download
# attempts). Freshness watchdog cadence for subscribed kline keys.
HISTORY_BACKFILL_MIN_INTERVAL_SECONDS=300
HISTORY_WATCHDOG_INTERVAL_SECONDS=300

# How long the plans config trusts its in-memory copy before re-reading the DB
# (default 60s). Request handlers call it on every strategy start; without the
# TTL each start pays a SELECT + YAML re-parse + file rewrite.
PLANS_DB_REFRESH_TTL_SECONDS=180

